# COPY in the Dockerfile does NOT respect .gitignore — this file is
# the only thing standing between .env and a public Docker image layer.
# Never remove the .env lines below.
.env
.env.*
!.env.example

.git
.gitignore
node_modules
demo/node_modules
broker/node_modules
demo/render
tools/
webmcp-session-handover.zip
*.log
.DS_Store
PROGRESS.md
